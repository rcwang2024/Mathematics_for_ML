    "class RootFinding:\n",
    "    def newton_method(self, f, df, x0, tol=1e-6, max_iter=100):\n",
    "        \"\"\"Newton's method for root finding\"\"\"\n",
    "        x = x0\n",
    "        history = [x]\n",
    "        \n",
    "        for i in range(max_iter):\n",
    "            fx = f(x)\n",
    "            dfx = df(x)\n",
    "            \n",
    "            if abs(dfx) < 1e-12:\n",
    "                print(f\"Derivative too small at iteration {i}\")\n",
    "                break\n",
    "                \n",
    "            x_new = x - fx / dfx\n",
    "            history.append(x_new)\n",
    "            \n",
    "            if abs(x_new - x) < tol:\n",
    "                print(f\"Newton converged in {i+1} iterations\")\n",
    "                return x_new, np.array(history)\n",
    "            \n",
    "            x = x_new\n",
    "        \n",
    "        print(f\"Newton did not converge in {max_iter} iterations\")\n",
    "        return x, np.array(history)\n",
    "    \n",
    "    def demo_root_finding(self):\n",
    "        \"\"\"Compare different root finding methods\"\"\"\n",
    "        # Function: f(x) = x³ - 2x - 5\n",
    "        f = lambda x: x**3 - 2*x - 5\n",
    "        df = lambda x: 3*x**2 - 2\n",
    "        \n",
    "        # Find root near x=2\n",
    "        x0 = 2.0\n",
    "        \n",
    "        # Newton's method\n",
    "        newton_root, newton_history = self.newton_method(f, df, x0)\n",
    "        \n",
    "        # Scipy methods for comparison\n",
    "        brent_result = optimize.brentq(f, 1, 3)\n",
    "        newton_scipy = optimize.newton(f, x0, df)\n",
    "        \n",
    "        print(f\"\\nRoot Finding Results:\")\n",
    "        print(f\"Custom Newton: {newton_root:.10f}\")\n",
    "        print(f\"Scipy Brent: {brent_result:.10f}\")\n",
    "        print(f\"Scipy Newton: {newton_scipy:.10f}\")\n",
    "        print(f\"Function value at root: {f(newton_root):.2e}\")\n",
    "        \n",
    "        return f, df, newton_history, newton_root\n",
    "\n",
    "root_finder = RootFinding()\n",
    "f, df, history, root = root_finder.demo_root_finding()"
   ]
