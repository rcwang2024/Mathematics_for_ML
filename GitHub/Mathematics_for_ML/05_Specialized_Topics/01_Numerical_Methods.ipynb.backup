   "outputs": [],
   "source": "import numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom scipy import optimize, integrate, interpolate, linalg, sparse\nfrom scipy.optimize import minimize\nfrom scipy.sparse import csc_matrix, diags\nfrom scipy.sparse.linalg import spsolve, eigsh, svds\nfrom sklearn.datasets import make_regression, load_diabetes\nfrom sklearn.preprocessing import StandardScaler, PolynomialFeatures\nfrom sklearn.linear_model import LinearRegression, Ridge\nfrom sklearn.decomposition import PCA\nimport time\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# Set random seed for reproducibility\nnp.random.seed(42)\n\n# Configure plotting\nplt.style.use('default')\nplt.rcParams['figure.figsize'] = (14, 10)\nplt.rcParams['font.size'] = 12\n\nclass AdvancedNumericalMethodsFramework:\n    \"\"\"\n    Comprehensive framework for advanced numerical methods\n    covering linear algebra, optimization, differential equations, and machine learning applications\n    \"\"\"\n    \n    def __init__(self):\n        self.results = {}\n        self.eps = np.finfo(float).eps  # Machine epsilon\n        \n    def demonstrate_error_analysis_and_conditioning(self):\n        \"\"\"\n        Comprehensive demonstration of error analysis and matrix conditioning\n        \"\"\"\n        print(\"=\" * 80)\n        print(\"ERROR ANALYSIS AND MATRIX CONDITIONING\")\n        print(\"=\" * 80)\n        \n        print(\"\\n1. FLOATING POINT ARITHMETIC AND MACHINE PRECISION\")\n        print(\"-\" * 60)\n        \n        # Machine precision analysis\n        print(f\"Machine epsilon (numpy): {np.finfo(float).eps:.2e}\")\n        print(f\"Machine epsilon (computed): {self.eps:.2e}\")\n        print(f\"Smallest positive float: {np.finfo(float).tiny:.2e}\")\n        print(f\"Largest positive float: {np.finfo(float).max:.2e}\")\n        \n        # Demonstrate loss of significance\n        def catastrophic_cancellation_demo():\n            \"\"\"Demonstrate catastrophic cancellation\"\"\"\n            x = 1.0\n            \n            # Computing f(x) = (1 - cos(x)) / x² for small x\n            # Direct computation vs stable reformulation\n            small_values = [1e-2, 1e-4, 1e-6, 1e-8, 1e-10]\n            \n            print(f\"\\nCatastrophic Cancellation Example: f(x) = (1 - cos(x)) / x²\")\n            print(f\"{'x':<12} {'Direct':<15} {'Stable':<15} {'Error':<15}\")\n            print(\"-\" * 60)\n            \n            for x in small_values:\n                # Direct (unstable) computation\n                direct = (1 - np.cos(x)) / (x**2)\n                \n                # Stable computation using f(x) = sin²(x/2) / (x/2)²\n                stable = (np.sin(x/2) / (x/2))**2\n                \n                # True value (Taylor series): f(x) = 1/2 - x²/24 + x⁴/720 - ...\n                true_value = 0.5 - x**2/24 + x**4/720\n                \n                error = abs(direct - stable) / abs(stable) if stable != 0 else float('inf')\n                \n                print(f\"{x:<12.0e} {direct:<15.8f} {stable:<15.8f} {error:<15.2e}\")\n        \n        catastrophic_cancellation_demo()\n        \n        print(\"\\n2. CONDITION NUMBERS AND MATRIX SENSITIVITY\")\n        print(\"-\" * 60)\n        \n        def condition_number_analysis():\n            \"\"\"Analyze condition numbers of different matrices\"\"\"\n            matrices = {\n                'Well-conditioned': np.eye(5),\n                'Ill-conditioned': linalg.hilbert(5),\n                'Random': np.random.randn(5, 5),\n                'Vandermonde': np.vander([1, 2, 3, 4, 5], increasing=True)\n            }\n            \n            print(f\"Matrix Condition Number Analysis:\")\n            print(f\"{'Matrix Type':<15} {'cond(A)':<15} {'log₁₀(cond)':<15}\")\n            print(\"-\" * 45)\n            \n            for name, A in matrices.items():\n                # Ensure matrix is square and full rank\n                if A.shape[0] != A.shape[1]:\n                    A = A @ A.T\n                \n                cond_num = np.linalg.cond(A)\n                log_cond = np.log10(cond_num) if cond_num < np.inf else np.inf\n                \n                print(f\"{name:<15} {cond_num:<15.2e} {log_cond:<15.2f}\")\n                \n                # For ill-conditioned matrix, show sensitivity\n                if name == 'Ill-conditioned':\n                    b = np.ones(5)\n                    x = np.linalg.solve(A, b)\n                    \n                    # Perturb right-hand side\n                    delta_b = 1e-10 * np.random.randn(5)\n                    x_perturbed = np.linalg.solve(A, b + delta_b)\n                    \n                    relative_error_input = np.linalg.norm(delta_b) / np.linalg.norm(b)\n                    relative_error_output = np.linalg.norm(x_perturbed - x) / np.linalg.norm(x)\n                    amplification = relative_error_output / relative_error_input\n                    \n                    print(f\"  Sensitivity analysis:\")\n                    print(f\"    Relative error in input: {relative_error_input:.2e}\")\n                    print(f\"    Relative error in output: {relative_error_output:.2e}\")\n                    print(f\"    Error amplification: {amplification:.2f}\")\n                    print(f\"    Condition number: {cond_num:.2f}\")\n        \n        condition_number_analysis()\n        \n        print(\"\\n3. BACKWARD ERROR ANALYSIS\")\n        print(\"-\" * 60)\n        \n        def backward_error_demo():\n            \"\"\"Demonstrate backward error analysis for linear systems\"\"\"\n            # Create a test system Ax = b\n            n = 5\n            A = np.random.randn(n, n)\n            A = A @ A.T + np.eye(n)  # Make positive definite\n            x_true = np.random.randn(n)\n            b = A @ x_true\n            \n            # Solve using different methods\n            methods = {\n                'NumPy solve': lambda A, b: np.linalg.solve(A, b),\n                'LU decomposition': lambda A, b: linalg.solve(A, b),\n                'QR decomposition': lambda A, b: linalg.lstsq(A, b)[0],\n            }\n            \n            print(f\"Backward Error Analysis for Linear Systems:\")\n            print(f\"{'Method':<18} {'Forward Error':<15} {'Backward Error':<15} {'Residual':<15}\")\n            print(\"-\" * 65)\n            \n            for name, solver in methods.items():\n                x_computed = solver(A, b)\n                \n                # Forward error\n                forward_error = np.linalg.norm(x_computed - x_true) / np.linalg.norm(x_true)\n                \n                # Backward error: find smallest δA, δb such that (A + δA)(x_computed) = b + δb\n                residual = A @ x_computed - b\n                backward_error = np.linalg.norm(residual) / (np.linalg.norm(A) * np.linalg.norm(x_computed) + np.linalg.norm(b))\n                \n                # Residual\n                residual_norm = np.linalg.norm(residual)\n                \n                print(f\"{name:<18} {forward_error:<15.2e} {backward_error:<15.2e} {residual_norm:<15.2e}\")\n        \n        backward_error_demo()\n        \n        return matrices\n    \n    def demonstrate_linear_systems_and_decompositions(self):\n        \"\"\"\n        Comprehensive demonstration of linear system solution methods and matrix decompositions\n        \"\"\"\n        print(\"\\n\" + \"=\" * 80)\n        print(\"LINEAR SYSTEMS AND MATRIX DECOMPOSITIONS\")\n        print(\"=\" * 80)\n        \n        print(\"\\n1. DIRECT METHODS FOR LINEAR SYSTEMS\")\n        print(\"-\" * 60)\n        \n        def direct_methods_comparison():\n            \"\"\"Compare different direct methods for solving linear systems\"\"\"\n            # Create test system\n            n = 100\n            A = np.random.randn(n, n)\n            A = A @ A.T + 0.1 * np.eye(n)  # Ensure positive definite\n            x_true = np.random.randn(n)\n            b = A @ x_true\n            \n            methods = {\n                'LU Decomposition': self._solve_lu,\n                'QR Decomposition': self._solve_qr,\n                'Cholesky': self._solve_cholesky,\n                'SVD': self._solve_svd\n            }\n            \n            print(f\"Direct Methods Comparison (n = {n}):\")\n            print(f\"{'Method':<18} {'Time (ms)':<12} {'Error':<15} {'Condition':<12}\")\n            print(\"-\" * 60)\n            \n            for name, method in methods.items():\n                start_time = time.time()\n                \n                try:\n                    x_computed = method(A, b)\n                    solve_time = (time.time() - start_time) * 1000\n                    error = np.linalg.norm(x_computed - x_true) / np.linalg.norm(x_true)\n                    \n                    # Estimate condition number for method\n                    if name == 'Cholesky':\n                        L = linalg.cholesky(A, lower=True)\n                        cond_est = np.linalg.cond(L)**2\n                    else:\n                        cond_est = np.linalg.cond(A)\n                    \n                    print(f\"{name:<18} {solve_time:<12.2f} {error:<15.2e} {cond_est:<12.2e}\")\n                    \n                except Exception as e:\n                    print(f\"{name:<18} {'Failed':<12} {str(e)[:15]:<15}\")\n            \n            return A, b, x_true\n        \n        A, b, x_true = direct_methods_comparison()\n        \n        print(\"\\n2. ITERATIVE METHODS FOR LINEAR SYSTEMS\")\n        print(\"-\" * 60)\n        \n        def iterative_methods_demo():\n            \"\"\"Demonstrate iterative methods for linear systems\"\"\"\n            # Create larger sparse system\n            n = 500\n            # Create a diagonally dominant matrix (ensures convergence)\n            A = diags([1, -4, 1], [-1, 0, 1], shape=(n, n), format='csc')\n            A = A.toarray()\n            A = A @ A.T + 2 * np.eye(n)  # Make positive definite and well-conditioned\n            \n            x_true = np.random.randn(n)\n            b = A @ x_true\n            \n            methods = {\n                'Jacobi': self._jacobi_method,\n                'Gauss-Seidel': self._gauss_seidel_method,\n                'SOR (ω=1.2)': lambda A, b, x0, tol, max_iter: self._sor_method(A, b, x0, 1.2, tol, max_iter),\n                'Conjugate Gradient': self._conjugate_gradient_method\n            }\n            \n            print(f\"Iterative Methods Comparison (n = {n}):\")\n            print(f\"{'Method':<18} {'Iterations':<12} {'Time (ms)':<12} {'Final Error':<15}\")\n            print(\"-\" * 60)\n            \n            x0 = np.zeros(n)\n            tol = 1e-6\n            max_iter = 1000\n            \n            for name, method in methods.items():\n                start_time = time.time()\n                \n                try:\n                    x_computed, iterations, errors = method(A, b, x0.copy(), tol, max_iter)\n                    solve_time = (time.time() - start_time) * 1000\n                    final_error = np.linalg.norm(x_computed - x_true) / np.linalg.norm(x_true)\n                    \n                    print(f\"{name:<18} {iterations:<12} {solve_time:<12.2f} {final_error:<15.2e}\")\n                    \n                except Exception as e:\n                    print(f\"{name:<18} {'Failed':<12} {'-':<12} {str(e)[:15]:<15}\")\n            \n            return A, b, x_true\n        \n        A_iter, b_iter, x_true_iter = iterative_methods_demo()\n        \n        print(\"\\n3. MATRIX DECOMPOSITIONS AND THEIR PROPERTIES\")\n        print(\"-\" * 60)\n        \n        def matrix_decomposition_analysis():\n            \"\"\"Analyze different matrix decompositions\"\"\"\n            # Create test matrix\n            m, n = 100, 80\n            A = np.random.randn(m, n)\n            \n            print(f\"Matrix Decomposition Analysis ({m}×{n} matrix):\")\n            print(f\"{'Decomposition':<20} {'Time (ms)':<12} {'Reconstruction Error':<20} {'Properties':<20}\")\n            print(\"-\" * 75)\n            \n            # LU Decomposition\n            start_time = time.time()\n            P, L, U = linalg.lu(A)\n            lu_time = (time.time() - start_time) * 1000\n            A_reconstructed = P @ L @ U\n            lu_error = np.linalg.norm(A - A_reconstructed) / np.linalg.norm(A)\n            print(f\"{'LU':<20} {lu_time:<12.2f} {lu_error:<20.2e} {'P: permutation':<20}\")\n            \n            # QR Decomposition\n            start_time = time.time()\n            Q, R = linalg.qr(A)\n            qr_time = (time.time() - start_time) * 1000\n            A_reconstructed = Q @ R\n            qr_error = np.linalg.norm(A - A_reconstructed) / np.linalg.norm(A)\n            orthogonality_error = np.linalg.norm(Q.T @ Q - np.eye(Q.shape[1]))\n            print(f\"{'QR':<20} {qr_time:<12.2f} {qr_error:<20.2e} {f'Orthogonal Q: {orthogonality_error:.1e}':<20}\")\n            \n            # SVD\n            start_time = time.time()\n            U, s, Vt = linalg.svd(A, full_matrices=False)\n            svd_time = (time.time() - start_time) * 1000\n            A_reconstructed = U @ np.diag(s) @ Vt\n            svd_error = np.linalg.norm(A - A_reconstructed) / np.linalg.norm(A)\n            print(f\"{'SVD':<20} {svd_time:<12.2f} {svd_error:<20.2e} {f'Rank: {len(s)}':<20}\")\n            \n            # Rank analysis\n            singular_values = s\n            print(f\"\\nSingular Value Analysis:\")\n            print(f\"  Largest singular value: {singular_values[0]:.2e}\")\n            print(f\"  Smallest singular value: {singular_values[-1]:.2e}\")\n            print(f\"  Condition number: {singular_values[0]/singular_values[-1]:.2e}\")\n            print(f\"  Numerical rank (tol=1e-12): {np.sum(singular_values > 1e-12)}\")\n            \n            return U, s, Vt, Q, R, L, U\n        \n        decomp_results = matrix_decomposition_analysis()\n        \n        return A, b, x_true, A_iter, b_iter, x_true_iter, decomp_results\n    \n    def demonstrate_eigenvalue_problems(self):\n        \"\"\"\n        Comprehensive demonstration of eigenvalue problems and algorithms\n        \"\"\"\n        print(\"\\n\" + \"=\" * 80)\n        print(\"EIGENVALUE PROBLEMS AND ALGORITHMS\")\n        print(\"=\" * 80)\n        \n        print(\"\\n1. STANDARD EIGENVALUE PROBLEM\")\n        print(\"-\" * 60)\n        \n        def standard_eigenvalue_demo():\n            \"\"\"Demonstrate eigenvalue computation methods\"\"\"\n            # Create symmetric test matrix for guaranteed real eigenvalues\n            n = 100\n            A = np.random.randn(n, n)\n            A = A @ A.T  # Make positive semidefinite\n            \n            methods = {\n                'Full eigendecomposition': lambda A: linalg.eigh(A),\n                'Largest eigenvalues': lambda A: eigsh(A, k=5, which='LA'),\n                'Smallest eigenvalues': lambda A: eigsh(A, k=5, which='SA'),\n            }\n            \n            print(f\"Eigenvalue Methods Comparison (n = {n}):\")\n            print(f\"{'Method':<25} {'Time (ms)':<12} {'Eigenvalues Found':<18} {'Residual Norm':<15}\")\n            print(\"-\" * 75)\n            \n            for name, method in methods.items():\n                start_time = time.time()\n                \n                try:\n                    if 'Full' in name:\n                        eigenvalues, eigenvectors = method(A)\n                        compute_time = (time.time() - start_time) * 1000\n                        \n                        # Check residual for largest eigenvalue\n                        lambda_max = eigenvalues[-1]\n                        v_max = eigenvectors[:, -1]\n                        residual = np.linalg.norm(A @ v_max - lambda_max * v_max)\n                        \n                        print(f\"{name:<25} {compute_time:<12.2f} {len(eigenvalues):<18} {residual:<15.2e}\")\n                        \n                    else:\n                        eigenvalues, eigenvectors = method(A)\n                        compute_time = (time.time() - start_time) * 1000\n                        \n                        # Check residual for computed eigenvalues\n                        residuals = []\n                        for i, (lam, v) in enumerate(zip(eigenvalues, eigenvectors.T)):\n                            residual = np.linalg.norm(A @ v - lam * v)\n                            residuals.append(residual)\n                        \n                        avg_residual = np.mean(residuals)\n                        print(f\"{name:<25} {compute_time:<12.2f} {len(eigenvalues):<18} {avg_residual:<15.2e}\")\n                        \n                except Exception as e:\n                    print(f\"{name:<25} {'Failed':<12} {'-':<18} {str(e)[:15]:<15}\")\n            \n            return A, eigenvalues, eigenvectors\n        \n        A_eig, eigenvalues, eigenvectors = standard_eigenvalue_demo()\n        \n        print(\"\\n2. GENERALIZED EIGENVALUE PROBLEM\")\n        print(\"-\" * 60)\n        \n        def generalized_eigenvalue_demo():\n            \"\"\"Demonstrate generalized eigenvalue problem Ax = λBx\"\"\"\n            n = 50\n            A = np.random.randn(n, n)\n            A = A @ A.T  # Make positive definite\n            B = np.random.randn(n, n)\n            B = B @ B.T + 0.1 * np.eye(n)  # Make positive definite\n            \n            # Solve generalized eigenvalue problem\n            start_time = time.time()\n            eigenvalues, eigenvectors = linalg.eigh(A, B)\n            solve_time = (time.time() - start_time) * 1000\n            \n            print(f\"Generalized Eigenvalue Problem: Ax = λBx\")\n            print(f\"Matrix size: {n}×{n}\")\n            print(f\"Computation time: {solve_time:.2f} ms\")\n            print(f\"Eigenvalue range: [{eigenvalues[0]:.3f}, {eigenvalues[-1]:.3f}]\")\n            \n            # Verify solution for largest eigenvalue\n            lambda_max = eigenvalues[-1]\n            v_max = eigenvectors[:, -1]\n            residual_A = A @ v_max\n            residual_B = lambda_max * B @ v_max\n            residual_norm = np.linalg.norm(residual_A - residual_B)\n            \n            print(f\"Residual for largest eigenvalue: {residual_norm:.2e}\")\n            \n            # Check B-orthogonality\n            V = eigenvectors\n            orthogonality = V.T @ B @ V\n            off_diagonal_norm = np.linalg.norm(orthogonality - np.diag(np.diag(orthogonality)))\n            print(f\"B-orthogonality error: {off_diagonal_norm:.2e}\")\n            \n            return A, B, eigenvalues, eigenvectors\n        \n        gen_results = generalized_eigenvalue_demo()\n        \n        print(\"\\n3. POWER METHOD AND INVERSE ITERATION\")\n        print(\"-\" * 60)\n        \n        def power_method_demo():\n            \"\"\"Demonstrate power method and its variants\"\"\"\n            n = 50\n            A = np.random.randn(n, n)\n            A = A @ A.T + np.eye(n)  # Ensure largest eigenvalue > 1\n            \n            # Standard power method for largest eigenvalue\n            def power_method(A, max_iter=100, tol=1e-6):\n                x = np.random.randn(A.shape[0])\n                x = x / np.linalg.norm(x)\n                \n                eigenvalue_history = []\n                \n                for i in range(max_iter):\n                    y = A @ x\n                    eigenvalue = x.T @ y\n                    x_new = y / np.linalg.norm(y)\n                    \n                    eigenvalue_history.append(eigenvalue)\n                    \n                    if np.linalg.norm(x_new - x) < tol:\n                        return eigenvalue, x_new, i+1, eigenvalue_history\n                    \n                    x = x_new\n                \n                return eigenvalue, x, max_iter, eigenvalue_history\n            \n            # Inverse power method for smallest eigenvalue\n            def inverse_power_method(A, max_iter=100, tol=1e-6):\n                x = np.random.randn(A.shape[0])\n                x = x / np.linalg.norm(x)\n                \n                eigenvalue_history = []\n                \n                for i in range(max_iter):\n                    y = linalg.solve(A, x)\n                    eigenvalue = x.T @ y\n                    x_new = y / np.linalg.norm(y)\n                    \n                    eigenvalue_history.append(1.0/eigenvalue)\n                    \n                    if np.linalg.norm(x_new - x) < tol:\n                        return 1.0/eigenvalue, x_new, i+1, eigenvalue_history\n                    \n                    x = x_new\n                \n                return 1.0/eigenvalue, x, max_iter, eigenvalue_history\n            \n            # Compare with exact eigenvalues\n            exact_eigenvalues = linalg.eigvals(A)\n            exact_max = np.max(exact_eigenvalues)\n            exact_min = np.min(exact_eigenvalues)\n            \n            # Power method\n            pm_eigenvalue, pm_eigenvector, pm_iter, pm_history = power_method(A)\n            \n            # Inverse power method\n            ipm_eigenvalue, ipm_eigenvector, ipm_iter, ipm_history = inverse_power_method(A)\n            \n            print(f\"Power Method Results:\")\n            print(f\"  Exact largest eigenvalue: {exact_max:.6f}\")\n            print(f\"  Power method result: {pm_eigenvalue:.6f}\")\n            print(f\"  Error: {abs(pm_eigenvalue - exact_max):.2e}\")\n            print(f\"  Iterations: {pm_iter}\")\n            \n            print(f\"\\nInverse Power Method Results:\")\n            print(f\"  Exact smallest eigenvalue: {exact_min:.6f}\")\n            print(f\"  Inverse power method result: {ipm_eigenvalue:.6f}\")\n            print(f\"  Error: {abs(ipm_eigenvalue - exact_min):.2e}\")\n            print(f\"  Iterations: {ipm_iter}\")\n            \n            return A, pm_history, ipm_history, exact_eigenvalues\n        \n        power_results = power_method_demo()\n        \n        return A_eig, eigenvalues, eigenvectors, gen_results, power_results\n    \n    def demonstrate_optimization_methods(self):\n        \"\"\"\n        Comprehensive demonstration of numerical optimization methods\n        \"\"\"\n        print(\"\\n\" + \"=\" * 80)\n        print(\"NUMERICAL OPTIMIZATION METHODS\")\n        print(\"=\" * 80)\n        \n        print(\"\\n1. UNCONSTRAINED OPTIMIZATION\")\n        print(\"-\" * 60)\n        \n        def unconstrained_optimization_demo():\n            \"\"\"Demonstrate various unconstrained optimization methods\"\"\"\n            # Define test functions\n            def rosenbrock(x):\n                \"\"\"Rosenbrock function\"\"\"\n                return 100 * (x[1] - x[0]**2)**2 + (1 - x[0])**2\n            \n            def rosenbrock_grad(x):\n                \"\"\"Gradient of Rosenbrock function\"\"\"\n                g = np.zeros(2)\n                g[0] = -400 * x[0] * (x[1] - x[0]**2) - 2 * (1 - x[0])\n                g[1] = 200 * (x[1] - x[0]**2)\n                return g\n            \n            def rosenbrock_hess(x):\n                \"\"\"Hessian of Rosenbrock function\"\"\"\n                H = np.zeros((2, 2))\n                H[0, 0] = -400 * (x[1] - 3*x[0]**2) + 2\n                H[0, 1] = H[1, 0] = -400 * x[0]\n                H[1, 1] = 200\n                return H\n            \n            # Starting point\n            x0 = np.array([-1.2, 1.0])\n            \n            # Optimization methods\n            methods = {\n                'Nelder-Mead': {'method': 'Nelder-Mead', 'jac': False, 'hess': False},\n                'BFGS': {'method': 'BFGS', 'jac': rosenbrock_grad, 'hess': False},\n                'Newton-CG': {'method': 'Newton-CG', 'jac': rosenbrock_grad, 'hess': rosenbrock_hess},\n                'L-BFGS-B': {'method': 'L-BFGS-B', 'jac': rosenbrock_grad, 'hess': False},\n                'Trust-NCG': {'method': 'trust-ncg', 'jac': rosenbrock_grad, 'hess': rosenbrock_hess}\n            }\n            \n            print(f\"Rosenbrock Function Optimization:\")\n            print(f\"Starting point: {x0}\")\n            print(f\"True minimum: [1, 1]\")\n            print()\n            print(f\"{'Method':<12} {'Final Value':<15} {'Iterations':<12} {'Func Evals':<12} {'Success':<8}\")\n            print(\"-\" * 70)\n            \n            results = {}\n            \n            for name, params in methods.items():\n                try:\n                    if params['hess']:\n                        result = minimize(rosenbrock, x0, method=params['method'], \n                                        jac=params['jac'], hess=params['hess'])\n                    elif params['jac']:\n                        result = minimize(rosenbrock, x0, method=params['method'], \n                                        jac=params['jac'])\n                    else:\n                        result = minimize(rosenbrock, x0, method=params['method'])\n                    \n                    results[name] = result\n                    \n                    print(f\"{name:<12} {result.fun:<15.6e} {result.nit:<12} {result.nfev:<12} {result.success:<8}\")\n                    \n                except Exception as e:\n                    print(f\"{name:<12} {'Failed':<15} {'-':<12} {'-':<12} {'False':<8}\")\n                    results[name] = None\n            \n            # Analyze convergence for BFGS\n            if 'BFGS' in results and results['BFGS'] is not None:\n                print(f\"\\nBFGS Solution Analysis:\")\n                bfgs_result = results['BFGS']\n                print(f\"  Final point: [{bfgs_result.x[0]:.6f}, {bfgs_result.x[1]:.6f}]\")\n                print(f\"  Distance from true minimum: {np.linalg.norm(bfgs_result.x - [1, 1]):.6e}\")\n                print(f\"  Gradient norm: {np.linalg.norm(rosenbrock_grad(bfgs_result.x)):.6e}\")\n            \n            return rosenbrock, rosenbrock_grad, results\n        \n        opt_results = unconstrained_optimization_demo()\n        \n        print(\"\\n2. GRADIENT DESCENT VARIANTS\")\n        print(\"-\" * 60)\n        \n        def gradient_descent_variants():\n            \"\"\"Implement and compare gradient descent variants\"\"\"\n            # Quadratic function for analysis\n            A = np.array([[3, 1], [1, 2]])  # Positive definite\n            b = np.array([1, 1])\n            \n            def quadratic_function(x):\n                return 0.5 * x.T @ A @ x - b.T @ x\n            \n            def quadratic_gradient(x):\n                return A @ x - b\n            \n            # True minimum\n            x_star = linalg.solve(A, b)\n            \n            # Gradient descent implementations\n            def vanilla_gd(grad_func, x0, learning_rate, max_iter=1000, tol=1e-6):\n                x = x0.copy()\n                history = [x.copy()]\n                \n                for i in range(max_iter):\n                    grad = grad_func(x)\n                    x_new = x - learning_rate * grad\n                    \n                    history.append(x_new.copy())\n                    \n                    if np.linalg.norm(x_new - x) < tol:\n                        return x_new, i+1, np.array(history)\n                    \n                    x = x_new\n                \n                return x, max_iter, np.array(history)\n            \n            def momentum_gd(grad_func, x0, learning_rate, momentum=0.9, max_iter=1000, tol=1e-6):\n                x = x0.copy()\n                v = np.zeros_like(x)\n                history = [x.copy()]\n                \n                for i in range(max_iter):\n                    grad = grad_func(x)\n                    v = momentum * v + learning_rate * grad\n                    x_new = x - v\n                    \n                    history.append(x_new.copy())\n                    \n                    if np.linalg.norm(x_new - x) < tol:\n                        return x_new, i+1, np.array(history)\n                    \n                    x = x_new\n                \n                return x, max_iter, np.array(history)\n            \n            def adam_optimizer(grad_func, x0, learning_rate=0.01, beta1=0.9, beta2=0.999, \n                             epsilon=1e-8, max_iter=1000, tol=1e-6):\n                x = x0.copy()\n                m = np.zeros_like(x)  # First moment\n                v = np.zeros_like(x)  # Second moment\n                history = [x.copy()]\n                \n                for i in range(max_iter):\n                    grad = grad_func(x)\n                    \n                    # Update biased first moment estimate\n                    m = beta1 * m + (1 - beta1) * grad\n                    \n                    # Update biased second raw moment estimate\n                    v = beta2 * v + (1 - beta2) * grad**2\n                    \n                    # Compute bias-corrected first moment estimate\n                    m_hat = m / (1 - beta1**(i + 1))\n                    \n                    # Compute bias-corrected second raw moment estimate\n                    v_hat = v / (1 - beta2**(i + 1))\n                    \n                    # Update parameters\n                    x_new = x - learning_rate * m_hat / (np.sqrt(v_hat) + epsilon)\n                    \n                    history.append(x_new.copy())\n                    \n                    if np.linalg.norm(x_new - x) < tol:\n                        return x_new, i+1, np.array(history)\n                    \n                    x = x_new\n                \n                return x, max_iter, np.array(history)\n            \n            # Test different methods\n            x0 = np.array([2.0, 2.0])\n            \n            methods = {\n                'Vanilla GD': lambda: vanilla_gd(quadratic_gradient, x0, 0.1),\n                'Momentum GD': lambda: momentum_gd(quadratic_gradient, x0, 0.1, 0.9),\n                'Adam': lambda: adam_optimizer(quadratic_gradient, x0, 0.1)\n            }\n            \n            print(f\"Gradient Descent Variants on Quadratic Function:\")\n            print(f\"True minimum: [{x_star[0]:.6f}, {x_star[1]:.6f}]\")\n            print()\n            print(f\"{'Method':<12} {'Final Error':<15} {'Iterations':<12} {'Convergence Rate':<18}\")\n            print(\"-\" * 60)\n            \n            histories = {}\n            \n            for name, method in methods.items():\n                x_final, iterations, history = method()\n                final_error = np.linalg.norm(x_final - x_star)\n                \n                # Estimate convergence rate\n                errors = [np.linalg.norm(x - x_star) for x in history]\n                if len(errors) > 10:\n                    # Linear convergence rate\n                    rate = errors[-1] / errors[-2] if errors[-2] > 0 else 0\n                    rate_str = f\"{rate:.4f}\"\n                else:\n                    rate_str = \"N/A\"\n                \n                histories[name] = history\n                \n                print(f\"{name:<12} {final_error:<15.6e} {iterations:<12} {rate_str:<18}\")\n            \n            return quadratic_function, quadratic_gradient, x_star, histories\n        \n        gd_results = gradient_descent_variants()\n        \n        print(\"\\n3. CONSTRAINED OPTIMIZATION\")\n        print(\"-\" * 60)\n        \n        def constrained_optimization_demo():\n            \"\"\"Demonstrate constrained optimization methods\"\"\"\n            # Minimize f(x) = (x[0] - 1)² + (x[1] - 2.5)² \n            # subject to: x[0] - 2*x[1] + 2 >= 0\n            #             -x[0] - 2*x[1] + 6 >= 0\n            #             -x[0] + 2*x[1] + 2 >= 0\n            \n            def objective(x):\n                return (x[0] - 1)**2 + (x[1] - 2.5)**2\n            \n            def objective_grad(x):\n                return np.array([2*(x[0] - 1), 2*(x[1] - 2.5)])\n            \n            # Constraints\n            def constraint1(x):\n                return x[0] - 2*x[1] + 2\n            \n            def constraint2(x):\n                return -x[0] - 2*x[1] + 6\n            \n            def constraint3(x):\n                return -x[0] + 2*x[1] + 2\n            \n            constraints = [\n                {'type': 'ineq', 'fun': constraint1},\n                {'type': 'ineq', 'fun': constraint2},\n                {'type': 'ineq', 'fun': constraint3}\n            ]\n            \n            x0 = np.array([0, 0])\n            \n            # Solve constrained problem\n            result = minimize(objective, x0, method='SLSQP', jac=objective_grad, \n                            constraints=constraints)\n            \n            print(f\"Constrained Optimization Results:\")\n            print(f\"  Objective function: f(x) = (x₁ - 1)² + (x₂ - 2.5)²\")\n            print(f\"  Starting point: {x0}\")\n            print(f\"  Optimal point: [{result.x[0]:.6f}, {result.x[1]:.6f}]\")\n            print(f\"  Optimal value: {result.fun:.6f}\")\n            print(f\"  Success: {result.success}\")\n            print(f\"  Iterations: {result.nit}\")\n            \n            # Check constraint satisfaction\n            print(f\"\\nConstraint Values at Optimum:\")\n            print(f\"  Constraint 1: {constraint1(result.x):.6f}\")\n            print(f\"  Constraint 2: {constraint2(result.x):.6f}\")\n            print(f\"  Constraint 3: {constraint3(result.x):.6f}\")\n            \n            return objective, result\n        \n        constrained_results = constrained_optimization_demo()\n        \n        return opt_results, gd_results, constrained_results\n    \n    def demonstrate_numerical_integration(self):\n        \"\"\"\n        Comprehensive demonstration of numerical integration methods\n        \"\"\"\n        print(\"\\n\" + \"=\" * 80)\n        print(\"NUMERICAL INTEGRATION AND QUADRATURE\")\n        print(\"=\" * 80)\n        \n        print(\"\\n1. BASIC QUADRATURE RULES\")\n        print(\"-\" * 60)\n        \n        def basic_quadrature_demo():\n            \"\"\"Demonstrate basic quadrature rules\"\"\"\n            # Test function: ∫₀¹ e^x dx = e - 1 ≈ 1.71828\n            def f(x):\n                return np.exp(x)\n            \n            true_value = np.e - 1\n            a, b = 0, 1\n            \n            # Implement basic quadrature rules\n            def trapezoidal_rule(f, a, b, n):\n                x = np.linspace(a, b, n+1)\n                y = f(x)\n                h = (b - a) / n\n                return h * (y[0]/2 + np.sum(y[1:-1]) + y[-1]/2)\n            \n            def simpson_rule(f, a, b, n):\n                if n % 2 == 1:\n                    n += 1  # Simpson's rule requires even number of intervals\n                x = np.linspace(a, b, n+1)\n                y = f(x)\n                h = (b - a) / n\n                return h/3 * (y[0] + 4*np.sum(y[1:-1:2]) + 2*np.sum(y[2:-2:2]) + y[-1])\n            \n            def midpoint_rule(f, a, b, n):\n                h = (b - a) / n\n                x = np.linspace(a + h/2, b - h/2, n)\n                return h * np.sum(f(x))\n            \n            methods = {\n                'Trapezoidal': trapezoidal_rule,\n                'Simpson': simpson_rule,\n                'Midpoint': midpoint_rule\n            }\n            \n            ns = [10, 20, 50, 100, 200]\n            \n            print(f\"Quadrature Rules for ∫₀¹ eˣ dx = {true_value:.6f}\")\n            print()\n            \n            for method_name, method in methods.items():\n                print(f\"{method_name} Rule:\")\n                print(f\"{'n':<6} {'Approximation':<15} {'Error':<15} {'Error Ratio':<12}\")\n                print(\"-\" * 50)\n                \n                prev_error = None\n                for n in ns:\n                    approx = method(f, a, b, n)\n                    error = abs(approx - true_value)\n                    \n                    if prev_error is not None:\n                        ratio = prev_error / error\n                        ratio_str = f\"{ratio:.2f}\"\n                    else:\n                        ratio_str = \"-\"\n                    \n                    print(f\"{n:<6} {approx:<15.8f} {error:<15.2e} {ratio_str:<12}\")\n                    prev_error = error\n                \n                print()\n            \n            return f, true_value, methods\n        \n        quad_results = basic_quadrature_demo()\n        \n        print(\"\\n2. ADAPTIVE QUADRATURE\")\n        print(\"-\" * 60)\n        \n        def adaptive_quadrature_demo():\n            \"\"\"Demonstrate adaptive quadrature methods\"\"\"\n            # Test with oscillatory function\n            def oscillatory_function(x):\n                return np.sin(20 * x) * np.exp(-x)\n            \n            # Compare with scipy's adaptive integration\n            from scipy import integrate\n            \n            a, b = 0, 3\n            \n            # Scipy's adaptive methods\n            methods = {\n                'quad (adaptive)': lambda f, a, b: integrate.quad(f, a, b)[0],\n                'romberg': lambda f, a, b: integrate.romberg(f, a, b),\n                'fixed_quad (n=50)': lambda f, a, b: integrate.fixed_quad(f, a, b, n=50)[0]\n            }\n            \n            print(f\"Adaptive Quadrature for Oscillatory Function:\")\n            print(f\"f(x) = sin(20x) * exp(-x) on [0, 3]\")\n            print()\n            print(f\"{'Method':<20} {'Result':<15} {'Time (ms)':<12}\")\n            print(\"-\" * 50)\n            \n            results = {}\n            for name, method in methods.items():\n                start_time = time.time()\n                try:\n                    result = method(oscillatory_function, a, b)\n                    compute_time = (time.time() - start_time) * 1000\n                    results[name] = result\n                    print(f\"{name:<20} {result:<15.8f} {compute_time:<12.2f}\")\n                except Exception as e:\n                    print(f\"{name:<20} {'Failed':<15} {'-':<12}\")\n            \n            return oscillatory_function, results\n        \n        adaptive_results = adaptive_quadrature_demo()\n        \n        print(\"\\n3. MONTE CARLO INTEGRATION\")\n        print(\"-\" * 60)\n        \n        def monte_carlo_integration_demo():\n            \"\"\"Demonstrate Monte Carlo integration methods\"\"\"\n            # Integrate over unit circle: ∫∫_{x²+y²≤1} (x² + y²) dx dy = π/2\n            def integrand(x, y):\n                return x**2 + y**2\n            \n            true_value = np.pi / 2\n            \n            # Basic Monte Carlo\n            def monte_carlo_basic(n_samples):\n                # Generate random points in [-1,1] × [-1,1]\n                x = np.random.uniform(-1, 1, n_samples)\n                y = np.random.uniform(-1, 1, n_samples)\n                \n                # Check if points are inside unit circle\n                inside = (x**2 + y**2) <= 1\n                \n                # Monte Carlo estimate\n                area_square = 4  # Area of [-1,1] × [-1,1]\n                area_circle = np.pi  # Area of unit circle\n                \n                if np.sum(inside) > 0:\n                    avg_value = np.mean(integrand(x[inside], y[inside]))\n                    estimate = area_circle * avg_value\n                else:\n                    estimate = 0\n                \n                return estimate\n            \n            # Importance sampling\n            def monte_carlo_importance(n_samples):\n                # Use importance sampling with density concentrated near origin\n                r = np.sqrt(np.random.uniform(0, 1, n_samples))\n                theta = np.random.uniform(0, 2*np.pi, n_samples)\n                \n                x = r * np.cos(theta)\n                y = r * np.sin(theta)\n                \n                # All points are inside unit circle by construction\n                values = integrand(x, y)\n                \n                # Importance sampling weight (uniform density over unit circle is 1/π)\n                estimate = np.pi * np.mean(values)\n                \n                return estimate\n            \n            sample_sizes = [1000, 5000, 10000, 50000, 100000]\n            \n            print(f\"Monte Carlo Integration of x² + y² over Unit Circle:\")\n            print(f\"True value: {true_value:.6f}\")\n            print()\n            print(f\"{'Sample Size':<12} {'Basic MC':<15} {'Error':<15} {'Importance MC':<15} {'Error':<15}\")\n            print(\"-\" * 75)\n            \n            for n in sample_sizes:\n                # Run multiple trials and average\n                n_trials = 10\n                \n                basic_estimates = [monte_carlo_basic(n) for _ in range(n_trials)]\n                importance_estimates = [monte_carlo_importance(n) for _ in range(n_trials)]\n                \n                basic_mean = np.mean(basic_estimates)\n                basic_error = abs(basic_mean - true_value)\n                \n                importance_mean = np.mean(importance_estimates)\n                importance_error = abs(importance_mean - true_value)\n                \n                print(f\"{n:<12} {basic_mean:<15.6f} {basic_error:<15.4e} {importance_mean:<15.6f} {importance_error:<15.4e}\")\n            \n            return integrand, true_value\n        \n        mc_results = monte_carlo_integration_demo()\n        \n        return quad_results, adaptive_results, mc_results\n    \n    def demonstrate_differential_equations(self):\n        \"\"\"\n        Comprehensive demonstration of numerical methods for differential equations\n        \"\"\"\n        print(\"\\n\" + \"=\" * 80)\n        print(\"NUMERICAL METHODS FOR DIFFERENTIAL EQUATIONS\")\n        print(\"=\" * 80)\n        \n        print(\"\\n1. ORDINARY DIFFERENTIAL EQUATIONS\")\n        print(\"-\" * 60)\n        \n        def ode_methods_demo():\n            \"\"\"Demonstrate ODE solution methods\"\"\"\n            # Test ODE: dy/dt = -2y + 1, y(0) = 0\n            # Analytical solution: y(t) = 0.5(1 - e^(-2t))\n            def dydt(t, y):\n                return -2*y + 1\n            \n            def analytical_solution(t):\n                return 0.5 * (1 - np.exp(-2*t))\n            \n            t_span = (0, 3)\n            y0 = [0]\n            t_eval = np.linspace(0, 3, 31)\n            \n            # Numerical methods\n            methods = ['RK45', 'RK23', 'DOP853', 'Radau', 'BDF', 'LSODA']\n            \n            print(f\"ODE Solution Methods for dy/dt = -2y + 1, y(0) = 0\")\n            print(f\"Analytical solution: y(t) = 0.5(1 - e^(-2t))\")\n            print()\n            print(f\"{'Method':<10} {'Final Error':<15} {'Steps':<8} {'Success':<8}\")\n            print(\"-\" * 45)\n            \n            results = {}\n            analytical_values = analytical_solution(t_eval)\n            \n            for method in methods:\n                try:\n                    start_time = time.time()\n                    sol = integrate.solve_ivp(dydt, t_span, y0, method=method, \n                                            t_eval=t_eval, rtol=1e-8, atol=1e-10)\n                    solve_time = (time.time() - start_time) * 1000\n                    \n                    if sol.success:\n                        final_error = abs(sol.y[0, -1] - analytical_values[-1])\n                        results[method] = sol\n                        \n                        print(f\"{method:<10} {final_error:<15.2e} {sol.nfev:<8} {sol.success:<8}\")\n                    else:\n                        print(f\"{method:<10} {'Failed':<15} {'-':<8} {'False':<8}\")\n                        \n                except Exception as e:\n                    print(f\"{method:<10} {'Error':<15} {'-':<8} {'False':<8}\")\n            \n            return dydt, analytical_solution, t_eval, analytical_values, results\n        \n        ode_results = ode_methods_demo()\n        \n        print(\"\\n2. STIFF DIFFERENTIAL EQUATIONS\")\n        print(\"-\" * 60)\n        \n        def stiff_ode_demo():\n            \"\"\"Demonstrate methods for stiff ODEs\"\"\"\n            # Van der Pol oscillator: stiff for large μ\n            mu = 1000  # Stiffness parameter\n            \n            def van_der_pol(t, y):\n                \"\"\"Van der Pol oscillator system\"\"\"\n                dydt = np.zeros(2)\n                dydt[0] = y[1]\n                dydt[1] = mu * (1 - y[0]**2) * y[1] - y[0]\n                return dydt\n            \n            t_span = (0, 2)\n            y0 = [2, 0]\n            \n            # Compare explicit vs implicit methods\n            explicit_methods = ['RK45', 'RK23']\n            implicit_methods = ['Radau', 'BDF']\n            \n            print(f\"Stiff ODE: Van der Pol Oscillator (μ = {mu})\")\n            print()\n            print(f\"{'Method':<10} {'Success':<8} {'Steps':<8} {'Time (ms)':<12}\")\n            print(\"-\" * 40)\n            \n            for method in explicit_methods + implicit_methods:\n                try:\n                    start_time = time.time()\n                    sol = integrate.solve_ivp(van_der_pol, t_span, y0, method=method, \n                                            rtol=1e-6, atol=1e-8)\n                    solve_time = (time.time() - start_time) * 1000\n                    \n                    print(f\"{method:<10} {sol.success:<8} {sol.nfev:<8} {solve_time:<12.2f}\")\n                    \n                except Exception as e:\n                    print(f\"{method:<10} {'Error':<8} {'-':<8} {'-':<12}\")\n            \n            return van_der_pol, mu\n        \n        stiff_results = stiff_ode_demo()\n        \n        print(\"\\n3. PARTIAL DIFFERENTIAL EQUATIONS\")\n        print(\"-\" * 60)\n        \n        def pde_demo():\n            \"\"\"Demonstrate finite difference methods for PDEs\"\"\"\n            # Heat equation: ∂u/∂t = α ∂²u/∂x²\n            # with initial condition u(x,0) = sin(πx) and boundary conditions u(0,t) = u(1,t) = 0\n            # Analytical solution: u(x,t) = sin(πx) * exp(-π²αt)\n            \n            alpha = 0.01  # Thermal diffusivity\n            L = 1.0  # Length\n            T = 0.1  # Final time\n            \n            # Spatial discretization\n            nx = 50\n            dx = L / (nx - 1)\n            x = np.linspace(0, L, nx)\n            \n            # Temporal discretization\n            dt = 0.5 * dx**2 / alpha  # CFL condition for stability\n            nt = int(T / dt)\n            \n            # Initial condition\n            u_initial = np.sin(np.pi * x)\n            \n            # Analytical solution\n            def analytical_solution(x, t):\n                return np.sin(np.pi * x) * np.exp(-np.pi**2 * alpha * t)\n            \n            # Explicit finite difference scheme\n            def explicit_finite_difference():\n                u = u_initial.copy()\n                r = alpha * dt / dx**2  # Diffusion number\n                \n                for n in range(nt):\n                    u_new = u.copy()\n                    for i in range(1, nx-1):\n                        u_new[i] = u[i] + r * (u[i+1] - 2*u[i] + u[i-1])\n                    \n                    # Boundary conditions\n                    u_new[0] = 0\n                    u_new[-1] = 0\n                    \n                    u = u_new\n                \n                return u\n            \n            # Implicit finite difference scheme (backward Euler)\n            def implicit_finite_difference():\n                u = u_initial.copy()\n                r = alpha * dt / dx**2\n                \n                # Build tridiagonal matrix\n                A = np.zeros((nx, nx))\n                A[0, 0] = 1  # Boundary condition\n                A[-1, -1] = 1  # Boundary condition\n                \n                for i in range(1, nx-1):\n                    A[i, i-1] = -r\n                    A[i, i] = 1 + 2*r\n                    A[i, i+1] = -r\n                \n                for n in range(nt):\n                    b = u.copy()\n                    b[0] = 0  # Boundary condition\n                    b[-1] = 0  # Boundary condition\n                    \n                    u = linalg.solve(A, b)\n                \n                return u\n            \n            # Solve using both methods\n            u_explicit = explicit_finite_difference()\n            u_implicit = implicit_finite_difference()\n            u_analytical = analytical_solution(x, T)\n            \n            # Compute errors\n            error_explicit = np.linalg.norm(u_explicit - u_analytical)\n            error_implicit = np.linalg.norm(u_implicit - u_analytical)\n            \n            print(f\"Heat Equation Solution (1D):\")\n            print(f\"  Grid points: {nx}\")\n            print(f\"  Time steps: {nt}\")\n            print(f\"  Final time: {T}\")\n            print(f\"  Diffusion number: {alpha * dt / dx**2:.4f}\")\n            print()\n            print(f\"  Explicit FD error: {error_explicit:.4e}\")\n            print(f\"  Implicit FD error: {error_implicit:.4e}\")\n            print(f\"  Max analytical value: {np.max(u_analytical):.4f}\")\n            \n            return x, u_explicit, u_implicit, u_analytical\n        \n        pde_results = pde_demo()\n        \n        return ode_results, stiff_results, pde_results\n    \n    def demonstrate_ml_applications(self):\n        \"\"\"\n        Demonstrate numerical methods in machine learning applications\n        \"\"\"\n        print(\"\\n\" + \"=\" * 80)\n        print(\"NUMERICAL METHODS IN MACHINE LEARNING\")\n        print(\"=\" * 80)\n        \n        print(\"\\n1. NUMERICAL OPTIMIZATION IN MACHINE LEARNING\")\n        print(\"-\" * 60)\n        \n        def ml_optimization_demo():\n            \"\"\"Demonstrate optimization methods for ML problems\"\"\"\n            # Generate synthetic data for logistic regression\n            np.random.seed(42)\n            n_samples, n_features = 1000, 10\n            X = np.random.randn(n_samples, n_features)\n            true_w = np.random.randn(n_features)\n            y = (X @ true_w + 0.1 * np.random.randn(n_samples)) > 0\n            y = y.astype(int)\n            \n            # Add bias term\n            X = np.column_stack([np.ones(n_samples), X])\n            \n            # Logistic regression objective and gradient\n            def logistic_loss(w, X, y):\n                z = X @ w\n                # Numerically stable computation\n                loss = np.mean(np.log(1 + np.exp(-y * (2*y - 1) * z)))\n                return loss\n            \n            def logistic_gradient(w, X, y):\n                z = X @ w\n                p = 1 / (1 + np.exp(-z))\n                gradient = X.T @ (p - y) / len(y)\n                return gradient\n            \n            # Optimization methods\n            def sgd_optimizer(X, y, learning_rate=0.01, max_iter=1000, batch_size=32):\n                w = np.random.randn(X.shape[1]) * 0.01\n                losses = []\n                \n                for i in range(max_iter):\n                    # Random mini-batch\n                    idx = np.random.choice(len(X), batch_size, replace=False)\n                    X_batch, y_batch = X[idx], y[idx]\n                    \n                    # Compute gradient and update\n                    grad = logistic_gradient(w, X_batch, y_batch)\n                    w = w - learning_rate * grad\n                    \n                    # Track loss on full dataset every 10 iterations\n                    if i % 10 == 0:\n                        loss = logistic_loss(w, X, y)\n                        losses.append(loss)\n                \n                return w, losses\n            \n            def lbfgs_optimizer(X, y):\n                w0 = np.random.randn(X.shape[1]) * 0.01\n                \n                result = minimize(logistic_loss, w0, args=(X, y), \n                                jac=logistic_gradient, method='L-BFGS-B')\n                \n                return result.x, [result.fun]\n            \n            # Compare methods\n            w_sgd, losses_sgd = sgd_optimizer(X, y)\n            w_lbfgs, losses_lbfgs = lbfgs_optimizer(X, y)\n            \n            # Evaluate performance\n            def accuracy(w, X, y):\n                predictions = (X @ w) > 0\n                return np.mean(predictions == y)\n            \n            acc_sgd = accuracy(w_sgd, X, y)\n            acc_lbfgs = accuracy(w_lbfgs, X, y)\n            \n            print(f\"Logistic Regression Optimization:\")\n            print(f\"  Dataset: {n_samples} samples, {n_features} features\")\n            print(f\"  SGD accuracy: {acc_sgd:.4f}\")\n            print(f\"  L-BFGS accuracy: {acc_lbfgs:.4f}\")\n            print(f\"  SGD final loss: {losses_sgd[-1]:.6f}\")\n            print(f\"  L-BFGS final loss: {losses_lbfgs[-1]:.6f}\")\n            \n            return X, y, w_sgd, w_lbfgs, losses_sgd, losses_lbfgs\n        \n        ml_opt_results = ml_optimization_demo()\n        \n        print(\"\\n2. MATRIX FACTORIZATIONS IN MACHINE LEARNING\")\n        print(\"-\" * 60)\n        \n        def ml_matrix_factorization_demo():\n            \"\"\"Demonstrate matrix factorizations for ML\"\"\"\n            # Generate data for dimensionality reduction\n            np.random.seed(42)\n            n_samples, n_features = 500, 50\n            n_components = 5\n            \n            # Create data with underlying low-rank structure\n            U_true = np.random.randn(n_samples, n_components)\n            V_true = np.random.randn(n_components, n_features)\n            X = U_true @ V_true + 0.1 * np.random.randn(n_samples, n_features)\n            \n            # Center the data\n            X_centered = X - np.mean(X, axis=0)\n            \n            # Principal Component Analysis via SVD\n            start_time = time.time()\n            U, s, Vt = linalg.svd(X_centered, full_matrices=False)\n            svd_time = (time.time() - start_time) * 1000\n            \n            # Explained variance ratio\n            explained_variance_ratio = (s**2) / np.sum(s**2)\n            cumulative_variance = np.cumsum(explained_variance_ratio)\n            \n            # Compare with sklearn PCA\n            from sklearn.decomposition import PCA\n            \n            start_time = time.time()\n            pca = PCA(n_components=n_components)\n            X_pca = pca.fit_transform(X)\n            pca_time = (time.time() - start_time) * 1000\n            \n            # Manual PCA reconstruction\n            X_reconstructed_manual = U[:, :n_components] @ np.diag(s[:n_components]) @ Vt[:n_components, :]\n            X_reconstructed_manual += np.mean(X, axis=0)\n            \n            # Sklearn PCA reconstruction\n            X_reconstructed_sklearn = pca.inverse_transform(X_pca)\n            \n            # Reconstruction errors\n            error_manual = np.linalg.norm(X - X_reconstructed_manual) / np.linalg.norm(X)\n            error_sklearn = np.linalg.norm(X - X_reconstructed_sklearn) / np.linalg.norm(X)\n            \n            print(f\"Principal Component Analysis:\")\n            print(f\"  Data shape: {X.shape}\")\n            print(f\"  Components: {n_components}\")\n            print(f\"  Manual SVD time: {svd_time:.2f} ms\")\n            print(f\"  Sklearn PCA time: {pca_time:.2f} ms\")\n            print(f\"  Manual reconstruction error: {error_manual:.6f}\")\n            print(f\"  Sklearn reconstruction error: {error_sklearn:.6f}\")\n            print(f\"  Explained variance (first 5 components): {cumulative_variance[:5]}\")\n            \n            return X, X_pca, explained_variance_ratio, U, s, Vt\n        \n        ml_matrix_results = ml_matrix_factorization_demo()\n        \n        print(\"\\n3. NUMERICAL STABILITY IN DEEP LEARNING\")\n        print(\"-\" * 60)\n        \n        def deep_learning_stability_demo():\n            \"\"\"Demonstrate numerical stability issues in deep learning\"\"\"\n            # Softmax numerical stability\n            def unstable_softmax(x):\n                \"\"\"Numerically unstable softmax\"\"\"\n                exp_x = np.exp(x)\n                return exp_x / np.sum(exp_x)\n            \n            def stable_softmax(x):\n                \"\"\"Numerically stable softmax\"\"\"\n                x_shifted = x - np.max(x)\n                exp_x = np.exp(x_shifted)\n                return exp_x / np.sum(exp_x)\n            \n            # Test with large values\n            x_large = np.array([1000, 1001, 1002])\n            x_normal = np.array([1, 2, 3])\n            \n            print(f\"Softmax Numerical Stability:\")\n            print(f\"Normal values {x_normal}:\")\n            print(f\"  Unstable: {unstable_softmax(x_normal)}\")\n            print(f\"  Stable: {stable_softmax(x_normal)}\")\n            \n            print(f\"Large values {x_large}:\")\n            try:\n                result_unstable = unstable_softmax(x_large)\n                print(f\"  Unstable: {result_unstable}\")\n            except:\n                print(f\"  Unstable: overflow error\")\n            \n            result_stable = stable_softmax(x_large)\n            print(f\"  Stable: {result_stable}\")\n            \n            # Gradient vanishing demonstration\n            def sigmoid(x):\n                return 1 / (1 + np.exp(-np.clip(x, -500, 500)))\n            \n            def sigmoid_derivative(x):\n                s = sigmoid(x)\n                return s * (1 - s)\n            \n            # Simulate deep network gradients\n            def simulate_gradient_flow(n_layers, activation='sigmoid'):\n                \"\"\"Simulate gradient flow through deep network\"\"\"\n                x = np.random.randn(100)  # Input\n                gradients = []\n                \n                for layer in range(n_layers):\n                    if activation == 'sigmoid':\n                        grad_factor = sigmoid_derivative(x)\n                    elif activation == 'relu':\n                        grad_factor = (x > 0).astype(float)\n                    else:\n                        grad_factor = np.ones_like(x)\n                    \n                    # Average gradient magnitude for this layer\n                    avg_grad = np.mean(np.abs(grad_factor))\n                    gradients.append(avg_grad)\n                    \n                    # Update x for next layer (simplified)\n                    x = x * grad_factor\n                \n                return gradients\n            \n            # Compare activation functions\n            layers = [5, 10, 15, 20]\n            \n            print(f\"\\nGradient Flow Analysis:\")\n            print(f\"{'Layers':<8} {'Sigmoid (avg grad)':<18} {'ReLU (avg grad)':<16}\")\n            print(\"-\" * 45)\n            \n            for n_layers in layers:\n                sigmoid_grads = simulate_gradient_flow(n_layers, 'sigmoid')\n                relu_grads = simulate_gradient_flow(n_layers, 'relu')\n                \n                avg_sigmoid = np.mean(sigmoid_grads)\n                avg_relu = np.mean(relu_grads)\n                \n                print(f\"{n_layers:<8} {avg_sigmoid:<18.6f} {avg_relu:<16.6f}\")\n            \n            return x_normal, x_large, layers\n        \n        dl_stability_results = deep_learning_stability_demo()\n        \n        return ml_opt_results, ml_matrix_results, dl_stability_results\n    \n    def comprehensive_demonstration(self):\n        \"\"\"\n        Run comprehensive demonstration of all advanced numerical methods\n        \"\"\"\n        print(\"ADVANCED NUMERICAL METHODS\")\n        print(\"Comprehensive Mathematical Framework for Scientific Computing\")\n        print(\"=\" * 80)\n        \n        # Run all demonstrations\n        error_results = self.demonstrate_error_analysis_and_conditioning()\n        linear_results = self.demonstrate_linear_systems_and_decompositions()\n        eigenvalue_results = self.demonstrate_eigenvalue_problems()\n        optimization_results = self.demonstrate_optimization_methods()\n        integration_results = self.demonstrate_numerical_integration()\n        de_results = self.demonstrate_differential_equations()\n        ml_results = self.demonstrate_ml_applications()\n        \n        print(\"\\n\" + \"=\" * 80)\n        print(\"COMPREHENSIVE SUMMARY: NUMERICAL METHODS MASTERY\")\n        print(\"=\" * 80)\n        \n        print(\"\\nKey Numerical Methods Demonstrated:\")\n        print(\"1. Error Analysis: Machine precision, conditioning, stability analysis\")\n        print(\"2. Linear Systems: Direct and iterative methods, matrix decompositions\")\n        print(\"3. Eigenvalue Problems: Standard, generalized, and sparse eigenvalue computation\")\n        print(\"4. Optimization: Unconstrained, constrained, and gradient-based methods\")\n        print(\"5. Numerical Integration: Quadrature rules, adaptive methods, Monte Carlo\")\n        print(\"6. Differential Equations: ODE and PDE solution methods\")\n        print(\"7. ML Applications: Optimization, matrix factorizations, numerical stability\")\n        \n        print(f\"\\nMathematical Sophistication:\")\n        print(f\"• Advanced algorithm analysis and implementation\")\n        print(f\"• Rigorous error analysis and stability theory\")\n        print(f\"• High-performance computing considerations\")\n        print(f\"• Machine learning and scientific computing applications\")\n        print(f\"• Modern computational techniques and best practices\")\n        \n        print(f\"\\nPractical Impact:\")\n        print(f\"• Foundation for all scientific computing applications\")\n        print(f\"• Essential for machine learning algorithm implementation\")\n        print(f\"• Critical for high-performance computing and optimization\")\n        print(f\"• Enables robust and efficient numerical software development\")\n        \n        return {\n            'error_analysis': error_results,\n            'linear_systems': linear_results,\n            'eigenvalue_problems': eigenvalue_results,\n            'optimization': optimization_results,\n            'integration': integration_results,\n            'differential_equations': de_results,\n            'ml_applications': ml_results\n        }\n    \n    # Helper methods for linear system solvers\n    def _solve_lu(self, A, b):\n        \"\"\"Solve using LU decomposition\"\"\"\n        lu, piv = linalg.lu_factor(A)\n        return linalg.lu_solve((lu, piv), b)\n    \n    def _solve_qr(self, A, b):\n        \"\"\"Solve using QR decomposition\"\"\"\n        Q, R = linalg.qr(A)\n        return linalg.solve_triangular(R, Q.T @ b)\n    \n    def _solve_cholesky(self, A, b):\n        \"\"\"Solve using Cholesky decomposition\"\"\"\n        L = linalg.cholesky(A, lower=True)\n        y = linalg.solve_triangular(L, b, lower=True)\n        return linalg.solve_triangular(L.T, y)\n    \n    def _solve_svd(self, A, b):\n        \"\"\"Solve using SVD\"\"\"\n        U, s, Vt = linalg.svd(A)\n        return Vt.T @ (np.diag(1/s) @ (U.T @ b))\n    \n    # Helper methods for iterative solvers\n    def _jacobi_method(self, A, b, x0, tol, max_iter):\n        \"\"\"Jacobi iterative method\"\"\"\n        D = np.diag(np.diag(A))\n        R = A - D\n        x = x0.copy()\n        errors = []\n        \n        for i in range(max_iter):\n            x_new = linalg.solve(D, b - R @ x)\n            error = np.linalg.norm(x_new - x)\n            errors.append(error)\n            \n            if error < tol:\n                return x_new, i+1, errors\n            \n            x = x_new\n        \n        return x, max_iter, errors\n    \n    def _gauss_seidel_method(self, A, b, x0, tol, max_iter):\n        \"\"\"Gauss-Seidel iterative method\"\"\"\n        x = x0.copy()\n        errors = []\n        \n        for i in range(max_iter):\n            x_old = x.copy()\n            \n            for j in range(len(x)):\n                x[j] = (b[j] - A[j, :j] @ x[:j] - A[j, j+1:] @ x_old[j+1:]) / A[j, j]\n            \n            error = np.linalg.norm(x - x_old)\n            errors.append(error)\n            \n            if error < tol:\n                return x, i+1, errors\n        \n        return x, max_iter, errors\n    \n    def _sor_method(self, A, b, x0, omega, tol, max_iter):\n        \"\"\"Successive Over-Relaxation method\"\"\"\n        x = x0.copy()\n        errors = []\n        \n        for i in range(max_iter):\n            x_old = x.copy()\n            \n            for j in range(len(x)):\n                sigma = A[j, :j] @ x[:j] + A[j, j+1:] @ x_old[j+1:]\n                x[j] = (1 - omega) * x_old[j] + omega * (b[j] - sigma) / A[j, j]\n            \n            error = np.linalg.norm(x - x_old)\n            errors.append(error)\n            \n            if error < tol:\n                return x, i+1, errors\n        \n        return x, max_iter, errors\n    \n    def _conjugate_gradient_method(self, A, b, x0, tol, max_iter):\n        \"\"\"Conjugate Gradient method\"\"\"\n        x = x0.copy()\n        r = b - A @ x\n        p = r.copy()\n        errors = []\n        \n        for i in range(max_iter):\n            Ap = A @ p\n            alpha = (r.T @ r) / (p.T @ Ap)\n            x = x + alpha * p\n            r_new = r - alpha * Ap\n            \n            error = np.linalg.norm(r_new)\n            errors.append(error)\n            \n            if error < tol:\n                return x, i+1, errors\n            \n            beta = (r_new.T @ r_new) / (r.T @ r)\n            p = r_new + beta * p\n            r = r_new\n        \n        return x, max_iter, errors\n\n# Create and run the comprehensive framework\nframework = AdvancedNumericalMethodsFramework()\ncomprehensive_results = framework.comprehensive_demonstration()"
  },
